{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "dependencies": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dependencies"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ScoreRequest": {
        "additionalProperties": false,
        "properties": {
          "feature_version": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feature Version"
          },
          "features": {
            "additionalProperties": {
              "type": "number"
            },
            "maxProperties": 100,
            "minProperties": 1,
            "title": "Features",
            "type": "object"
          },
          "transaction": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction"
          },
          "txn_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Txn Id",
            "type": "string"
          }
        },
        "required": [
          "txn_id",
          "features"
        ],
        "title": "ScoreRequest",
        "type": "object"
      },
      "ScoreResponse": {
        "properties": {
          "data_quality_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Data Quality Score",
            "type": "number"
          },
          "decision_basis": {
            "title": "Decision Basis",
            "type": "string"
          },
          "feature_contributions": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Feature Contributions",
            "type": "object"
          },
          "feature_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feature Version"
          },
          "review_recommended": {
            "title": "Review Recommended",
            "type": "boolean"
          },
          "risk_category": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Risk Category",
            "type": "string"
          },
          "risk_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Score",
            "type": "number"
          },
          "scored_at": {
            "format": "date-time",
            "title": "Scored At",
            "type": "string"
          },
          "scorer_version": {
            "title": "Scorer Version",
            "type": "string"
          },
          "transaction": {
            "additionalProperties": true,
            "title": "Transaction",
            "type": "object"
          },
          "triggered_rules": {
            "items": {
              "type": "string"
            },
            "title": "Triggered Rules",
            "type": "array"
          },
          "txn_id": {
            "title": "Txn Id",
            "type": "string"
          }
        },
        "required": [
          "txn_id",
          "risk_score",
          "risk_category",
          "data_quality_score",
          "decision_basis",
          "scorer_version",
          "review_recommended",
          "feature_contributions",
          "triggered_rules",
          "transaction",
          "scored_at"
        ],
        "title": "ScoreResponse",
        "type": "object"
      },
      "ScoresListResponse": {
        "properties": {
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "scores": {
            "items": {
              "$ref": "#/components/schemas/ScoreResponse"
            },
            "title": "Scores",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "scores",
          "total",
          "limit",
          "offset"
        ],
        "title": "ScoresListResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Deterministic reference risk policy with explicit validation limitations",
    "title": "AML Risk Scoring API",
    "version": "3.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/evaluate": {
      "post": {
        "description": "Read-only preview: does not overwrite stored scores or emit events.",
        "operationId": "evaluate_transaction_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate Transaction"
      }
    },
    "/health": {
      "get": {
        "operationId": "readiness_health_get",
        "responses": {
