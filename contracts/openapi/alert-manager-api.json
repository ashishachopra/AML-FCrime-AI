{
  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "alert_id": {
            "title": "Alert Id",
            "type": "string"
          },
          "alert_type": {
            "title": "Alert Type",
            "type": "string"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "decision_basis": {
            "title": "Decision Basis",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": true,
            "title": "Evidence",
            "type": "object"
          },
          "investigation_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Notes"
          },
          "revision": {
            "default": 1,
            "title": "Revision",
            "type": "integer"
          },
          "risk_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Score",
            "type": "number"
          },
          "sar_generated_by": {
            "anyOf": [
              {
                "enum": [
                  "openai",
                  "template"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sar Generated By"
          },
          "sar_generation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sar Generation Reason"
          },
          "sar_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sar Model"
          },
          "sar_narrative": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sar Narrative"
          },
          "sar_review_status": {
            "enum": [
              "not_generated",
              "draft_pending_review",
              "approved",
              "rejected"
            ],
            "title": "Sar Review Status",
            "type": "string"
          },
          "sar_reviewed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sar Reviewed At"
          },
          "sar_reviewed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sar Reviewed By"
          },
          "scorer_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scorer Version"
          },
          "status": {
            "enum": [
              "open",
              "investigating",
              "closed",
              "false_positive"
            ],
            "title": "Status",
            "type": "string"
          },
          "txn_id": {
            "title": "Txn Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "alert_id",
          "txn_id",
          "risk_score",
          "status",
          "alert_type",
          "created_at",
          "updated_at",
          "decision_basis",
          "evidence",
          "sar_review_status"
        ],
        "title": "Alert",
        "type": "object"
      },
      "AlertUpdate": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor",
            "type": "string"
          },
          "assigned_to": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "investigation_notes": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Notes"
          },
          "sar_review_status": {
            "anyOf": [
              {
                "enum": [
                  "approved",
                  "rejected"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sar Review Status"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "open",
                  "investigating",
                  "closed",
                  "false_positive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "expected_revision",
          "actor"
        ],
        "title": "AlertUpdate",
        "type": "object"
      },
      "AlertsResponse": {
        "properties": {
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "title": "Alerts",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "alerts",
          "total",
          "limit",
          "offset"
        ],
        "title": "AlertsResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "dependencies": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dependencies"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
